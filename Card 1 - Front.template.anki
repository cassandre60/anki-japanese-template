<!-- FRONT CARD TEMPLATE
     Premium Ergonomic Japanese Front Card

       Behavior:
       - Standard: Shows Sentence (or Expression) if Definition / Extended definition exists. Zero audio on front.
       - Listening (Policy B): #listening (or the legacy audio-only shape)
         activates the listening front ONLY when usable audio exists.
         The tag-listening-view binds to {{Sentence Audio}} (label 文),
         falling back to {{Word Audio}} (label 言葉) — never the hardcoded
         play:a:0 (which plays the first audio field = Word Audio on
         listening cards). #listening + no usable audio falls back to the
         normal sentence front. The resolver removes every dead/duplicate
         view so exactly one listening button is ever visible.
       - Cloze Fallback: Sentence without a bold term (jidoushio mobile
         exports) is rebuilt in JS from cloze-prefix + <b>cloze-body</b>
         + cloze-suffix when all three are non-empty; otherwise the
         usual sentence is kept untouched.
       - Frequency legacy: No definitions but Frequency present (old cards with deleted glosses) → usual sentence, never the audio button.
       - Fallback: Shows Sentence / Expression if both definitions and audio are missing.
- Mature Word Mode (desktop only): If the card interval >= LONG_INTERVAL_DAYS
          (script constant), the front shows only the Expression instead of the
          sentence (anti-overlearning). The interval comes from a
          fallback-only AnkiConnect content search (Expression → Sentence →
          cloze-body discriminators) — the live guiCurrentCard reviewer read
          was REMOVED so reviewer and Browse previewer share one identical
          path. It never picks candidate 0 blindly and fails safely to the
          sentence front on ambiguity.
          On Android/mobile Mature Word Mode is INTENTIONALLY DISABLED: the
          template makes no AnkiDroid JS API call and no AnkiConnect fetch
          (the fetch is UA-guarded inside `post`), because refused localhost
          requests surface natively as false "Card Content Error: Failed to
          load" media warnings in the reviewer. Mobile always keeps the
          ordinary sentence front. Any failure falls back to the sentence
          front.
         - Front sentence sizing: pure CSS (base clamp + smaller phone
           override in the stylesheet's mobile block). No JS involved.
         - Front reveal is deterministic and safe: the anti-flash
           visibility gate never depends on a single async path or timer
           that can be throttled into a blank front. R shortcut is
           Anki-owned; the template's custom shortcuts are Z/X/C only.

         Minimalism (PRODUCT.md): the front shows NO other UI — no tags,
         no badges, no metadata, no labels, NO AUDIO on normal cards.
         Front template size is not a defect; correctness > line count.
-->

<div class="card-wrapper">
  <div class="card-container" style="visibility: hidden;">
    <!-- Mature-Card Word Mode probe: shown instead of sentence when interval >= threshold -->
    <div class="front-word-display">{{edit:Expression}}</div>

    <!-- Cloze-fallback probe (jidoushio mobile exports): hidden source
         parts for JS sentence reconstruction when Sentence has no bold
         term. Plain filters — never displayed, never edited. -->
    <div class="cloze-probe" hidden>
      <span class="cloze-pre">{{cloze-prefix}}</span>
      <span class="cloze-mid">{{cloze-body}}</span>
      <span class="cloze-suf">{{cloze-suffix}}</span>
    </div>

    <!-- Behavioral tag probe: tags are behavioral metadata, never rendered as decoration.
         #listening Policy B: the tag-listening-view activates only when usable
         audio exists. To avoid Anki's C++/Python reviewer auto-playing audio on
         EVERY tagged card on card load (which happens whenever [sound:...] is
         in the front HTML regardless of CSS display:none), the tag-listening-view
         does NOT embed raw {{Sentence Audio}} / {{Word Audio}} fields.
         Instead, it delegates to Anki's Answer-side (Back) audio via replay links
         (play:a:N on desktop, playsound:a:N on AnkiDroid).
         On the back card, Word Audio is first and Sentence Audio is second:
         - Both exist → Sentence Audio is a:1 (label 文)
         - Only Sentence Audio exists → Sentence Audio is a:0 (label 文)
         - Only Word Audio exists (fallback) → Word Audio is a:0 (label 言葉)
         - Neither exists → tag-listening-view is not rendered (Policy B: falls
           back to the normal sentence front).
         This guarantees:
         1. ZERO audio autoplay on normal cards (no [sound:...] on front)
         2. #listening cards WITH definitions can still activate
         3. Button plays Sentence Audio (a:1 when both exist, matching 文 label)
         4. Desktop uses pycmd('play:a:N') with return false (no security block)
         5. AnkiDroid uses href="playsound:a:N" -->
    {{#Tags}}
      <div class="tags-probe" hidden>{{Tags}}</div>
      {{#Sentence Audio}}
        {{#Word Audio}}
          <div class="listening-view tag-listening-view" style="display: none;">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="例文音声を再生" aria-label="例文音声を再生" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <span class="audio-btn-content">
                  <span class="audio-btn-label">文</span>
                </span>
              </button>
              <span class="raw-audio-source" aria-hidden="true"><a class="replay-button soundLink" href="playsound:a:1" onclick="if(typeof pycmd!=='undefined'){pycmd('play:a:1');return false;}"></a></span>
            </div>
          </div>
        {{/Word Audio}}
        {{^Word Audio}}
          <div class="listening-view tag-listening-view" style="display: none;">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="例文音声を再生" aria-label="例文音声を再生" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <span class="audio-btn-content">
                  <span class="audio-btn-label">文</span>
                </span>
              </button>
              <span class="raw-audio-source" aria-hidden="true"><a class="replay-button soundLink" href="playsound:a:0" onclick="if(typeof pycmd!=='undefined'){pycmd('play:a:0');return false;}"></a></span>
            </div>
          </div>
        {{/Word Audio}}
      {{/Sentence Audio}}
      {{^Sentence Audio}}
      {{#Word Audio}}
        <div class="listening-view tag-listening-view" style="display: none;">
          <div class="audio-btn-wrapper">
            <button type="button" class="circular-audio-btn large-audio-btn" title="単語音声を再生" aria-label="単語音声を再生" onclick="playCircularAudio(this)">
              <svg class="audio-progress-ring" viewBox="0 0 80 80">
                <circle class="ring-bg" cx="40" cy="40" r="36" />
                <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
              </svg>
              <span class="audio-btn-content">
                <span class="audio-btn-label">言葉</span>
              </span>
            </button>
            <span class="raw-audio-source" aria-hidden="true"><a class="replay-button soundLink" href="playsound:a:0" onclick="if(typeof pycmd!=='undefined'){pycmd('play:a:0');return false;}"></a></span>
          </div>
        </div>
      {{/Word Audio}}
      {{/Sentence Audio}}
    {{/Tags}}

    <!-- Standard Study View -->
    {{#Definition}}
      <div class="sentence-display">
        {{#Sentence}}
          {{edit:Sentence}}
        {{/Sentence}}
        {{^Sentence}}
          {{edit:Expression}}
        {{/Sentence}}
      </div>
    {{/Definition}}

    <!-- Fallback Standard View (When only Extended definition is present) -->
    {{^Definition}}
      {{#Extended definition}}
        <div class="sentence-display">
          {{#Sentence}}
            {{edit:Sentence}}
          {{/Sentence}}
          {{^Sentence}}
            {{edit:Expression}}
          {{/Sentence}}
        </div>
      {{/Extended definition}}
    {{/Definition}}

    <!-- Listening Mode / Pathological Fallback -->
    {{^Definition}}
      {{^Extended definition}}

        <!-- Frequency present but definitions missing (legacy cards with
             deleted English glosses): NOT a listening card — show the
             usual sentence instead of the audio button. -->
        {{#Frequency}}
            <div class="sentence-display">
              {{#Sentence}}
                {{edit:Sentence}}
              {{/Sentence}}
              {{^Sentence}}
                {{edit:Expression}}
              {{/Sentence}}
            </div>
        {{/Frequency}}

        {{^Frequency}}
        <!-- Sentence Audio available: only rendered on pure listening cards (no glosses, no frequency) -->
        {{#Sentence Audio}}
          <div class="listening-view classic-listening-view">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="音声再生" aria-label="音声再生" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <span class="audio-btn-content">
                  <span class="audio-btn-label">文</span>
                </span>
              </button>
              <span class="raw-audio-source" aria-hidden="true">{{Sentence Audio}}</span>
            </div>
          </div>
        {{/Sentence Audio}}

        {{^Sentence Audio}}
        {{#Word Audio}}
          <div class="listening-view classic-listening-view">
            <div class="audio-btn-wrapper">
              <button type="button" class="circular-audio-btn large-audio-btn" title="音声再生" aria-label="音声再生" onclick="playCircularAudio(this)">
                <svg class="audio-progress-ring" viewBox="0 0 80 80">
                  <circle class="ring-bg" cx="40" cy="40" r="36" />
                  <circle class="ring-fill" cx="40" cy="40" r="36" stroke-dasharray="226.19" stroke-dashoffset="226.19" />
                </svg>
                <span class="audio-btn-content">
                  <span class="audio-btn-label">言葉</span>
                </span>
              </button>
              <span class="raw-audio-source" aria-hidden="true">{{Word Audio}}</span>
            </div>
          </div>
        {{/Word Audio}}
        {{/Sentence Audio}}

        <!-- Bulletproof Fallback: No Sentence audio -->
        {{^Sentence Audio}}
            <div class="sentence-display">
              {{#Sentence}}
                {{edit:Sentence}}
              {{/Sentence}}
              {{^Sentence}}
                {{edit:Expression}}
              {{/Sentence}}
            </div>
        {{/Sentence Audio}}
        {{/Frequency}}
      {{/Extended definition}}
    {{/Definition}}

  </div>
</div>

<script>
  (async function() {
    /* --- 1. HOISTED UTILITIES & FUNCTIONS --- */

    /* --- CIRCULAR AUDIO CONTROLLER (native-only) ---
       Always delegates to Anki's own replay link (desktop `replay-button`,
       AnkiDroid `replaybutton`). Never constructs an HTML5 audio element:
       on AnkiDroid the rendered link carries no usable filename (old builds
       emit `playsound:q:0`, which would be loaded as a bogus file and fail).
       The ring is a playback indicator (a decorative play-pulse), not true
       progress — native audio remains the authority (ADR 003). */
    window.currentActiveBtn = window.currentActiveBtn || null;
    window.currentActiveTimer = window.currentActiveTimer || null;
    /* WebView DOM re-use: never pin a detached button across card flips. */
    if (typeof window.addEventListener === 'function') {
        window.addEventListener('pagehide', () => { try { window.resetAudioState(); } catch (_) {} });
    }

    window.resetAudioState = function() {
        if (window.currentActiveTimer) {
            clearTimeout(window.currentActiveTimer);
            window.currentActiveTimer = null;
        }
        if (window.currentActiveBtn) {
            window.currentActiveBtn.classList.remove('is-playing');
            const ring = window.currentActiveBtn.querySelector('.ring-fill');
            if (ring) {
                const circ = parseFloat(ring.getAttribute('stroke-dasharray')) || 226.19;
                ring.style.transition = '';
                ring.style.strokeDashoffset = circ;
            }
            window.currentActiveBtn = null;
        }
    };

    window.playCircularAudio = function(btn) {
        /* Debounce: native playback can't be stopped programmatically, so
           ignore rapid re-taps on the already-playing button (prevents
           overlapping audio on AnkiDroid). */
        if (window.currentActiveBtn === btn) return;
        window.resetAudioState();
        const ringFill = btn.querySelector('.ring-fill');

        /* The replay link lives in the sibling .raw-audio-source (kept OUT
           of the <button>: <a> inside <button> is invalid HTML and Android
           WebView mishandles taps on it). */
        const scope = (btn.closest && btn.closest('.audio-btn-wrapper')) || document;
        const nativeReplay = scope.querySelector('.replaybutton, .replay-button, a.sound, .soundLink')
          || btn.querySelector('.replaybutton, .replay-button, a.sound, .soundLink');
        let played = false;
        if (nativeReplay) {
            try { nativeReplay.click(); played = true; } catch (e) {}
        }
        /* Last-resort fallback (removed): every listening view now carries
           a real .raw-audio-source (the actual audio field), so the
           nativeReplay.click() path above is the only path — it plays the
           field the button is labelled with. A hardcoded pycmd('play:a:0')
           would play the first audio field regardless of label, so silent
           no-op is safer than the wrong audio. */
        if (played || nativeReplay) {
            btn.classList.add('is-playing');
            if (ringFill) {
                ringFill.style.transition = 'stroke-dashoffset 0.8s ease-in-out';
                ringFill.style.strokeDashoffset = '0';
            }
            window.currentActiveBtn = btn;
            window.currentActiveTimer = setTimeout(() => {
                if (window.currentActiveBtn === btn) {
                    window.resetAudioState();
                }
            }, 800);
        }
    };

    /* --- 2. MAIN EXECUTION BLOCK --- */
    const container = document.querySelector('.card-container');
    const wrapper = document.querySelector('.card-wrapper');

    if (container && wrapper) {
      let wordMode = false;
      let interval = null;
      let source = 'unavailable';
      /* Latency probe: t0 at script start; elapsed retrieval time is
         logged with the decision, so AnkiConnect (desktop) cost can be
         measured per card. */
      const nowMs = () => (
        (typeof performance !== 'undefined' && performance.now)
          ? performance.now()
          : Date.now()
      );
      const t0 = nowMs();

      /* Safety Reveal: Ensure card shows even if async calls hang.
         Timing budget: 500ms AnkiConnect race / 1200ms reveal cap. The
         cap only binds failure paths; the word-mode toggle runs before
         reveal. Mobile skips retrieval entirely, so it reveals at once. */
      const reveal = () => {
        container.style.visibility = 'visible';
      };
      const safetyTimeout = setTimeout(reveal, 1200);

      /* --- CLOZE FALLBACK (BEGIN — headless check extracts this block verbatim) ---
         jidoujisho mobile exports often carry a Sentence with no <b>
         target term. When the rendered sentence has no bold element but
         the cloze trio (prefix/body/suffix) is complete, rebuild it as
         prefix + <b>body</b> + suffix so the front is indistinguishable
         from a proper Yomitan sentence (same .sentence-display b styling).
         Any gap or failure keeps the original sentence untouched. */
      try {
        const probe = container.querySelector('.cloze-probe');
        const probeText = (sel) => {
          const el = probe && probe.querySelector(sel);
          return el ? (el.textContent || '').replace(/\s+/g, ' ').trim() : '';
        };
        const clozePre = probeText('.cloze-pre');
        const clozeMid = probeText('.cloze-mid');
        const clozeSuf = probeText('.cloze-suf');
        if (clozePre && clozeMid && clozeSuf) {
          container.querySelectorAll('.sentence-display').forEach((sd) => {
            if (!sd.querySelector('b, strong')) {
              sd.textContent = '';
              const bold = document.createElement('b');
              bold.textContent = clozeMid;
              sd.append(
                document.createTextNode(clozePre),
                bold,
                document.createTextNode(clozeSuf)
              );
            }
          });
        }
      } catch (clozeErr) {
        console.warn('[Cloze Fallback]', clozeErr);
      }
      /* --- CLOZE FALLBACK (END) --- */

      /* Empty-field collapse (QUALITY.md): after the cloze rebuild, a
         sentence block with no text at all (neither Sentence nor
         Expression) leaves no padded void. Runs before the reveal. */
      try {
        const hasVisualContent = (sd) =>
          !!sd.querySelector('img, video, audio, source, picture, canvas, svg, iframe, object, embed');
        container.querySelectorAll('.sentence-display').forEach((sd) => {
          // Only collapse when there is neither textual nor visual content.
          // A pasted screenshot sentence has an <img> but no text nodes;
          // textContent-only checks would wrongly strip an image-only front
          // (e.g. 油断大敵).
          if ((!sd.textContent || !sd.textContent.trim()) && !hasVisualContent(sd)) sd.remove();
        });
      } catch (blankErr) {
        console.warn('[Blank Collapse]', blankErr);
      }

      /* --- LISTENING RESOLVER (Policy B) ---
         A card activates the listening front ONLY when usable audio exists:
         1. #listening tag (deliberate exercise): the tag-listening-view must
            have a real .raw-audio-source (Sentence Audio, or Word Audio as
            fallback). #listening + no usable audio → fall back to the normal
            sentence front. Never leave a dead/empty listening UI.
         2. Classic audio-only / pathological legacy card: Definition, Extended
            definition, and Frequency are absent and audio is present
            (classic-listening-view).
         Normal study cards without #listening tag never show audio on front.

         Exactly-one-listening-button invariant: the markup may render both a
         tag-listening-view and a classic-listening-view for the same audio;
         the resolver keeps only the active one and removes every dead/
         duplicate view, plus strips any listening view whose audio source
         is empty (missing field). */
      const tagsProbe = container.querySelector('.tags-probe');
      const tagText = tagsProbe ? (tagsProbe.textContent || '') : '';
      const hasListeningTag = /(^|[\s:#])listening([\s:#]|$)/i.test(tagText);
      const tagView = container.querySelector('.tag-listening-view');
      const classicView = container.querySelector('.classic-listening-view');

      const hasUsableAudio = (view) => {
        if (!view) return false;
        const src = view.querySelector('.raw-audio-source');
        if (!src) return false;
        const hasLink = !!src.querySelector('a, .replaybutton, .replay-button, .soundLink');
        const hasText = !!(src.textContent || '').replace(/\s+/g, ' ').trim();
        return hasLink || hasText;
      };

      let isListening = false;
      if (hasListeningTag && hasUsableAudio(tagView)) {
        isListening = true;
        tagView.style.display = '';
        wrapper.classList.add('listening-mode');
        container.querySelectorAll('.sentence-display').forEach((sd) => sd.remove());
        if (classicView) classicView.remove();
        setTimeout(function() {
          const btn = tagView.querySelector('.circular-audio-btn');
          if (btn && window.playCircularAudio) window.playCircularAudio(btn);
        }, 120);
      } else if (classicView && hasUsableAudio(classicView)) {
        isListening = true;
        wrapper.classList.add('listening-mode');
        container.querySelectorAll('.sentence-display').forEach((sd) => sd.remove());
        if (tagView) tagView.remove();
      }
      /* Dead/duplicate view cleanup: any listening-view that was not activated
         is removed so it never leaves a silent/empty audio button behind. */
      if (!isListening) {
        container.querySelectorAll('.listening-view').forEach((v) => v.remove());
      }

      /* Static early-exit: with no Expression, word mode is impossible (the
         hasExpression gate below), so the whole retrieval chain —
         AnkiConnect content search — is skipped and the sentence front
         reveals now.
         Failure-identical to the universal fallback, ~50ms faster per such
         card on desktop. The class toggle is explicit because WebView DOM
         re-use can carry word-mode over from the previous card. */
      var wordProbeEarly = container.querySelector('.front-word-display');
      if (!isListening && wordProbeEarly && !(wordProbeEarly.textContent || '').trim()) {
        clearTimeout(safetyTimeout);
        wrapper.classList.toggle('word-mode', false);
        reveal();
        return;
      }

      /* Anki-Connect helper with timeout + platform guard. 500ms is ~15x
         the measured healthy localhost latency (~25ms/call), so it only
         ever binds a wedged/busy Anki — and the fallback is always the
         safe sentence front, never a hang.

         PLATFORM GUARD — DESKTOP-ONLY (this is the downloadfile.bin fix):
         fetch() only
         runs on desktop Anki (QtWebEngine). On AnkiDroid the WebView has
         no AnkiConnect, the request 404s into a media download, and
         Android surfaces it natively as "Card Content Error: Failed to
         load 'downloadfile.bin'". Mobile never reaches any fetch; word
         mode simply stays off (sentence front), by design. */
      const post = (action, params) => {
        if (typeof fetch !== 'function') {
          return Promise.reject(new Error('fetch unavailable (mobile)'));
        }
        const ua = (typeof navigator !== 'undefined' && navigator.userAgent) || '';
        if (/Android|iPhone|iPad|iPod/i.test(ua)) {
          return Promise.reject(new Error('AnkiConnect is desktop-only'));
        }
        /* Belt-and-braces allowlist: 127.0.0.1:8765 is Anki desktop's local
           HTTP server; only QtWebEngine (desktop Anki's engine) may ever
           fetch it. AnkiDroid's WebView UA can never contain QtWebEngine,
           so this rejects even if the platform check above were bypassed. */
        if (!/QtWebEngine/i.test(ua)) {
          return Promise.reject(new Error('requires desktop QtWebEngine'));
        }
        const ctl = (typeof AbortController !== 'undefined') ? new AbortController() : null;
        const timeout = new Promise((_, rej) =>
          setTimeout(() => { try { ctl && ctl.abort(); } catch (_) {} rej(new Error('AnkiConnect timeout')); }, 500)
        );
        const fetchPromise = fetch('http://127.0.0.1:8765', {
          method: 'POST',
          ...(ctl ? { signal: ctl.signal } : {}),
          body: JSON.stringify({ action: action, version: 6, params: params })
        }).then(r => r.json()).then(data => {
          if (data.error) throw new Error(data.error);
          return data.result;
        });
        return Promise.race([fetchPromise, timeout]);
      };

      const escQuery = (s) => s.replace(/\\/g, '\\\\').replace(/"/g, '\\"').replace(/([*_():-])/g, '\\$1');
      const normText = (s) => s
        .replace(/<br\s*\/?>/gi, ' ')
        .replace(/<[^>]+>/g, ' ')
        .replace(/&nbsp;/gi, ' ')
        .replace(/\s+/g, ' ')
        .trim();

      try {
        /* Fallback-only word mode: no AnkiConnect fetch in this branch —
           the content search below IS the primary path now. */
        if (!isListening) {
          /* BROWSE-PREVIEWER CONTENT SEARCH.
             Identity is reconstructed from field content. NEVER pick
             candidate 0 blindly — duplicates are common (same Expression
             across many notes). Use Sentence then cloze-body as
             discriminators; if ambiguity remains after both, fail safely
             to the sentence front (interval stays null → no word mode). */
          const wordEl = document.querySelector('.front-word-display');
          const sentEl = document.querySelector('.sentence-display');
          if (wordEl) {
            const exprDom = normText(wordEl.innerText || wordEl.textContent || '');
            if (exprDom) {
              /* No "note:" clause: the note type name is not exposed to
                 templates ({{Type}} is the scheduling type, not the
                 model name), and the exact Expression field match below
                 already restricts results to this note type's cards. */
              const query = '"Expression:' + escQuery(exprDom) + '"';
              let ids = await post('findCards', { query: query });
              /* Bound: a common Expression can match hundreds of notes;
                 materialising every cardsInfo would jank the previewer.
                 Over-broad → sentence fallback (same safe default). */
              if (ids && ids.length > 50) {
                source = 'content-search-too-broad → sentence fallback';
                ids = [];
              }
              if (ids && ids.length) {
                const infos = await post('cardsInfo', { cards: ids });
                const fieldText = (info, name) =>
                  normText((info.fields && info.fields[name] && info.fields[name].value) || '');
                let candidates = infos.filter(i => fieldText(i, 'Expression') === exprDom);
                if (candidates.length > 1 && sentEl) {
                  /* Discriminator 1: Sentence. The front sentence is
                     the strongest content signal — it is unique per
                     mined note in practice. */
                  const sentDom = normText(sentEl.innerText || sentEl.textContent || '');
                  if (sentDom) {
                    const withSent = candidates.filter(i => fieldText(i, 'Sentence') === sentDom);
                    if (withSent.length) candidates = withSent;
                  }
                }
                if (candidates.length > 1) {
                  /* Discriminator 2: cloze-body. The cloze trio is
                     rendered on the front (hidden probe), so its body
                     text is available as a second identity signal. */
                  const clozeProbe = container.querySelector('.cloze-probe .cloze-mid');
                  const clozeDom = clozeProbe
                    ? normText(clozeProbe.innerText || clozeProbe.textContent || '')
                    : '';
                  if (clozeDom) {
                    const withCloze = candidates.filter(i =>
                      fieldText(i, 'cloze-body') === clozeDom);
                    if (withCloze.length) candidates = withCloze;
                  }
                }
                /* Exact-card resolution: only one candidate remains after
                   discriminators → use its interval. Multiple candidates
                   (ambiguous) → fail safely to the sentence front. Never
                   pick candidate 0. */
                if (candidates.length === 1) {
                  interval = candidates[0].interval;
                  source = 'content-search';
                } else if (candidates.length > 1) {
                  source = 'content-search-ambiguous → sentence fallback';
                }
              }
            }
          }
        }
      } catch (e) {
        source = 'error: ' + (e && e.message ? e.message : String(e));
        console.warn('[Mature Word Mode]', e);
      } finally {
        clearTimeout(safetyTimeout);
        const elapsedMs = Math.round(nowMs() - t0);
        console.log('[Mature Word Mode] source=' + source +
          ' ivl=' + String(interval) + ' in ' + elapsedMs + 'ms');

        const LONG_INTERVAL_DAYS = 365;

        // Set to false after confirming that Android works.
        const DEBUG_MATURE_MODE = false;

        const wordEl = container.querySelector('.front-word-display');
        const hasExpression = !!(
          wordEl && (wordEl.textContent || '').trim()
        );

        wordMode =
          typeof interval === 'number' &&
          Number.isFinite(interval) &&
          interval >= LONG_INTERVAL_DAYS &&
          !isListening &&
          hasExpression;

        // Explicitly reset the class as well as enabling it.
        wrapper.classList.toggle('word-mode', wordMode);

        if (DEBUG_MATURE_MODE) {
          let diagnostic = wrapper.querySelector('.mwm-debug');

          if (!diagnostic) {
            diagnostic = document.createElement('div');
            diagnostic.className = 'mwm-debug';
            diagnostic.style.cssText =
              'padding:6px 10px;' +
              'font:12px/1.4 sans-serif;' +
              'color:var(--text-secondary,#888);' +
              'overflow-wrap:anywhere;' +
              'text-align:left;';
            wrapper.appendChild(diagnostic);
          }

          diagnostic.textContent =
            'Mature mode: ' + (wordMode ? 'ON' : 'OFF') +
            ' | interval=' + String(interval) +
            ' | threshold=' + LONG_INTERVAL_DAYS +
            ' | source=' + source +
            ' | ' + elapsedMs + 'ms';
        }

        reveal();
      }
    }
  })();
</script>
